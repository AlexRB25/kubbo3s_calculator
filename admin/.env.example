# Copia este archivo como .env.local y rellénalo.

# Supabase: Project Settings → API Keys.
# La clave secreta (sb_secret_... o la antigua service_role) solo vive aquí, en el servidor: nunca en la app móvil.
PB_SUPABASE_URL=
PB_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Correos (separados por coma) que pueden entrar al dashboard. Pueden ser cuentas creadas desde
# la app o en Supabase → Authentication → Users.
ADMIN_EMAILS=

# Dirección del sitio web de la calculadora (https://…), para abrir los catálogos desde Catálogos y dominios. Opcional.
WEB_URL=
