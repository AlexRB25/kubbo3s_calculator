# Copia este archivo como .env.local y rellénalo.

# Supabase: Project Settings → API Keys. SOLO la clave publicable; la secreta nunca va en la app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección de la calculadora web (https://…), sin diagonal final: la pestaña Herramientas le pide ahí el
# enlace para abrir cada herramienta con tu sesión.
EXPO_PUBLIC_WEB_URL=https://calculator.kubbo3d.com
