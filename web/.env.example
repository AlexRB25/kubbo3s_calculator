# Copia este archivo como .env.local y rellénalo.

# Supabase: Project Settings → API Keys. Solo la clave publicable: este sitio no usa la secreta.
PB_SUPABASE_URL=
PB_SUPABASE_PUBLISHABLE_KEY=

# Dominio padre compartido con los demás sitios Kubbo3D (por ejemplo .kubbo3d.com) para que una sola sesión
# sirva en todos. Vacío en localhost.
PB_COOKIE_DOMAIN=

# ── Cobro de la tienda y del marketplace con Stripe (solo servidor) ──
# Sin estas variables la tienda sigue funcionando, pero el pago queda manual (instrucciones + WhatsApp).
# Clave secreta: dashboard.stripe.com → Desarrolladores → Claves de API. Usa sk_test_… al probar y sk_live_… al publicar.
STRIPE_SECRET_KEY=
# Secreto del webhook (Desarrolladores → Webhooks → Agregar destino) con la URL https://<este sitio>/api/stripe/webhook
# y los eventos checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded y
# charge.dispute.created. Sin él, los pagos con OXXO y los reembolsos no se registran solos.
STRIPE_WEBHOOK_SECRET=
# Clave secreta de Supabase: con ella el servidor lee el pedido a cobrar y lo marca como pagado.
SUPABASE_SECRET_KEY=
# Dirección pública del sitio, sin diagonal final (https://tudominio.com). Vacía = la de la petición.
SITE_URL=
# ── Catálogos públicos de los usuarios (Mi catálogo) ──
# Siempre se ven en <SITE_URL>/c/<dirección>. Opcional: un dominio solo para catálogos, con DNS comodín
# (*.kubbo3d.shop apuntando a este sitio) para que cada uno tenga mitaller.kubbo3d.shop.
PB_CATALOG_DOMAIN=
# A dónde apuntan los usuarios su dominio propio con un registro CNAME (en Vercel: cname.vercel-dns.com).
# El dominio también se agrega al proyecto en el hosting y se marca como conectado en el panel admin → Catálogos.
# Para servir dominios propios este sitio necesita SITE_URL o PB_COOKIE_DOMAIN, para saber cuáles hosts son suyos.
PB_CATALOG_CNAME=

# ── Herramientas en la app móvil ──
# Dirección del sitio de herramientas, sin diagonal final. Vacía = https://tools.kubbo3d.com. La app abre
# cada herramienta ahí, ya con la sesión iniciada (usa SUPABASE_SECRET_KEY para el enlace de un solo uso).
TOOLS_URL=
